From: Sam Richards <me@smallsam.com>
Subject: [PATCH] MIPS: octeon: use cores parked by the Cisco WLCNG boot loader

The Cisco WLCNG boot loader starts a data plane application on cores 0 and
1 and only hands the remaining cores to Linux. If that application is
replaced by a stub which parks its core and flags that in the CIU mailbox,
claim those cores and release them into kernel_entry when they are brought
up.

Signed-off-by: Sam Richards <me@smallsam.com>
---
--- a/arch/mips/cavium-octeon/smp.c
+++ b/arch/mips/cavium-octeon/smp.c
@@ -16,6 +16,7 @@
 #include <linux/init.h>
 #include <linux/export.h>
 #include <linux/kexec.h>
+#include <linux/of.h>
 
 #include <asm/mmu_context.h>
 #include <asm/time.h>
@@ -137,6 +138,34 @@
 #endif
 }
 
+/*
+ * Cisco WLCNG controllers: the boot loader starts a data plane application on
+ * cores 0 and 1 and only hands the other cores to Linux. If that application
+ * has been replaced by a stub which parks its core and flags that by setting
+ * bit 31 in the core's CIU mailbox, make those cores available to Linux too.
+ * The stub jumps to the physical address that is written to its mailbox.
+ */
+#define OCTEON_PARKED_CORE_FLAG		0x80000000
+static unsigned int octeon_parked_cores;
+
+static void __init octeon_claim_parked_cores(struct cvmx_sysinfo *sysinfo)
+{
+	int id;
+
+	if (!of_machine_is_compatible("cisco,ct2504"))
+		return;
+
+	for (id = 0; id < 2; id++) {
+		if (cvmx_coremask_is_core_set(&sysinfo->core_mask, id))
+			continue;
+		if (!(cvmx_read_csr(CVMX_CIU_MBOX_CLRX(id)) &
+		      OCTEON_PARKED_CORE_FLAG))
+			continue;
+		sysinfo->core_mask.coremask_bitmap[0] |= 1ull << id;
+		octeon_parked_cores |= 1 << id;
+	}
+}
+
 static void __init octeon_smp_setup(void)
 {
 	const int coreid = cvmx_get_core_num();
@@ -149,6 +178,8 @@
 	unsigned int num_cores = cvmx_octeon_num_cores();
 #endif
 
+	octeon_claim_parked_cores(sysinfo);
+
 	/* The present CPUs are initially just the boot cpu (CPU 0). */
 	for (id = 0; id < NR_CPUS; id++) {
 		set_cpu_possible(id, id == 0);
@@ -208,11 +239,19 @@
  */
 static int octeon_boot_secondary(int cpu, struct task_struct *idle)
 {
+	int coreid = cpu_logical_map(cpu);
 	int count;
 
 	pr_info("SMP: Booting CPU%02d (CoreId %2d)...\n", cpu,
 		cpu_logical_map(cpu));
 
+	if (octeon_parked_cores & (1 << coreid)) {
+		/* Release the parked core into the kernel entry point. */
+		cvmx_write_csr(CVMX_CIU_MBOX_CLRX(coreid), 0xffffffff);
+		cvmx_write_csr(CVMX_CIU_MBOX_SETX(coreid),
+			       __pa_symbol(kernel_entry));
+	}
+
 	octeon_processor_sp = __KSTK_TOS(idle);
 	octeon_processor_gp = (unsigned long)(task_thread_info(idle));
 	octeon_processor_boot = cpu_logical_map(cpu);
